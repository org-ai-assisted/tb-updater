## style-ok: no-has - self-contained; runs via pam_exec with a minimal environment.
## style-ok: R-003 - 3-space indent to match the tb-updater helpers.

## Layer the Tor Browser exec exception for the Tor Browser account.
##
## remount-secure keeps /home noexec system-wide at level 3, but Tor Browser must
## exec from '~/.tb' (and its '~/.cache/tb'). This runs as root via pam_exec in
## the session stack (Priority 95, after pam_mkhomedir at Priority 100 created the
## home). It acts ONLY when the session already runs in a mount namespace unshared
## from init (pam_namespace active, having run earlier in the stack), so the exec
## bind-remount is session-local to the Tor Browser user and visible to the browser
## it launches. In the init namespace (pam_namespace inactive) it does NOTHING: a
## remount there would be system-wide and permanent, so the namespace guard below
## is what keeps this safe -- not an assumption that pam_namespace is present.
##
## This is the single exec-remount trigger for the user's home, on both non-Qubes
## and Qubes. On Qubes the DispVM data layout (binding the read-only
## /var/cache/tb-binary into the home) is still prepared by
## tb-updater-dispvm.service; this hook only ensures the home dirs are exec, and
## the shared helper's per-directory noexec gate makes a redundant pass a no-op.
##
## No-op unless /home is currently noexec (remount-secure level 3).

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## pam_exec may run with a minimal PATH; resolve mount/findmnt reliably.
PATH='/usr/sbin:/usr/bin:/sbin:/bin'

## Shared exec-remount core (symlink guard, ownership prep, noexec->exec remount),
## resolved as a sibling so it works from the install path and a source checkout.
tb_remount_exec_lib="$(dirname -- "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")/tb-remount-exec.bsh"
# shellcheck source=./tb-remount-exec.bsh
source "${tb_remount_exec_lib}"

## pam_exec runs the helper on session open and close; only act on open.
if [ "${PAM_TYPE:-}" = 'close_session' ]; then
   exit 0
fi

## Only for the Tor Browser account's own login (Kicksecure default 'user').
tb_user="${tb_home_exec_user:-user}"
if [ "${PAM_USER:-}" != "${tb_user}" ]; then
   exit 0
fi

home_folder="/home/${tb_user}"

## pam_mkhomedir has not created the home yet, or it was removed.
if [ ! -d "${home_folder}" ]; then
   exit 0
fi

## Only act when /home is currently noexec (remount-secure level 3). At lower
## levels Tor Browser already execs from its home, so this is a strict no-op.
mount_options="$(findmnt --noheadings --output options --target "${home_folder}" || true)"
case ",${mount_options}," in
   *,noexec,*)
      true "INFO: '${home_folder}' is noexec; applying the Tor Browser exec exception."
      ;;
   *)
      exit 0
      ;;
esac

## Act ONLY in a mount namespace unshared from init. Without pam_namespace the
## session shares init's namespace, where this bind-remount would be system-wide
## and never undone (pam_exec close_session does not umount) -- and a user-planted
## symlink could then make an arbitrary noexec path exec for the whole system. In
## that case do nothing; torbrowser's launch-time check_noexec (exit 5) is the
## fail-safe until pam_namespace lands. (pam_namespace must run EARLIER in the
## session stack than this hook, or the namespace is not yet unshared here and the
## exception is skipped -- verify the ordering when pam_namespace ships.)
if [ "$(readlink /proc/self/ns/mnt)" = "$(readlink /proc/1/ns/mnt)" ]; then
   true "INFO: mount namespace shared with init (pam_namespace inactive); skipping."
   exit 0
fi

## An unshared namespace is necessary but not sufficient: unshare(2) keeps each
## mount's propagation type, so with /home shared (the systemd default) the exec
## remounts below would propagate back to init's peer group -- system-wide, exactly
## what the guard is meant to prevent. Make this session's tree slave: it still sees
## system mounts (receives propagation) but emits none, so the exec exception stays
## local to the session. Enforced here, never assumed of pam_namespace.
mount --make-rslave /

tb_dir="${home_folder}/.tb"
tb_cache_parent="${home_folder}/.cache"
tb_cache_dir="${tb_cache_parent}/tb"

## Refuse a user-planted symlink at the final component of any target before the
## bind-remount. Defense in depth: TOCTOU-racy and parent components are unchecked,
## so it is NOT the primary guard -- privilege-dropped creation (below) removes the
## root create+chown escalation, and the namespace guard above confines the remount
## to this session. The residual, a same-session race swapping a target for a
## symlink between this check and the remount, is session-local to this account.
tb_remount_exec_refuse_symlinks "${tb_dir}" "${tb_cache_parent}" "${tb_cache_dir}" || exit 1

## Pre-create (AS the account, not root) so a first 'update-torbrowser' install
## lands in an exec mount. Privilege-dropped so a user-planted parent symlink
## cannot redirect a root mkdir/chown onto an arbitrary path.
## style-ok: lpe-symlink-follow -- remount is namespace-confined; see note above.
tb_remount_exec_prepare_owner "${tb_user}" "${tb_dir}" "${tb_cache_parent}" "${tb_cache_dir}"

## Session-local exec exception (no-op per directory if already exec).
tb_remount_exec_apply "${tb_dir}"
tb_remount_exec_apply "${tb_cache_dir}"
